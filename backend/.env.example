ENVIRONMENT=development

# ── PostgreSQL (pgvector) ─────────────────────────────────────────────────────
# Matches the root docker-compose.yml (Postgres on port 5433). Use 127.0.0.1,
# not localhost: on Windows, localhost tries IPv6 first and every new DB
# connection then waits ~2 s.
DATABASE_URL=postgresql+asyncpg://jev:jev_dev_password@127.0.0.1:5433/jev_coding

# ── Jev decision engine ───────────────────────────────────────────────────────
# Only the route you use needs a key (configs/config.yaml -> jev.route).
# Without any key, use the "search-rank" stand-in engine.
#
# Vercel AI Gateway — https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# OpenCode Zen (default route) — https://opencode.ai/zen
OPENCODE_API_KEY=
