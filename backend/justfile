dev:
    uv run uvicorn app.main:app --port 8001 --reload

start:
    uv run uvicorn app.main:app --host 0.0.0.0 --port 8001 --workers 2

# ── Tests ─────────────────────────────────────────────────────────────────────

# Run all tests
test:
    uv run pytest tests/ -v

# Run a specific test file or test by keyword
# Usage: just test-k tabular
test-k K:
    uv run pytest tests/ -k "{{K}}" -v

# ── Terminology ───────────────────────────────────────────────────────────────

# ICD-10-CM FY2027 — free, no account, ~98k codes (74,879 billable)
# Download: https://ftp.cdc.gov/pub/Health_Statistics/NCHS/Publications/ICD10CM/2027/
#   -> icd10cm-code-descriptions-2027.zip  (required)
#   -> icd10cm-table-and-index-2027.zip    (inclusion terms + notes)
# Zips are read in place — no need to extract. Re-running replaces the release.
terminology-icd10cm FILE="../data/icd10cm-code-descriptions-2027.zip" TABULAR="../data/icd10cm-table-and-index-2027.zip":
    uv run python -m app.terminology.import_.cli --source icd10cm --file {{FILE}} --tabular-file {{TABULAR}}

# ICD-10-CM Alphabetic Index — ~71k term -> code links (synonyms, eponyms,
# "see" cross-references) loaded as searchable terms. Holds out
# terminology.index_holdout_percent of terms for evaluation (configs/config.yaml).
# Needs the code set loaded first. Re-running replaces the release's terms.
terminology-index FILE="../data/icd10cm-table-and-index-2027.zip":
    uv run python -m app.terminology.import_.cli --source icd10cm-index --file {{FILE}}

# Embed concepts and index terms for semantic search, using the model in
# configs/config.yaml (LM Studio server must be running). Resumable — Ctrl+C
# and re-run to continue. TARGET = all | concepts | index-terms; LIMIT = trial run:
#   just terminology-embeddings index-terms 2000
terminology-embeddings TARGET="all" LIMIT="":
    uv run python -m app.terminology.import_.cli --source embeddings --target {{TARGET}} {{ if LIMIT != "" { "--limit " + LIMIT } else { "" } }}

# ── Evaluation ────────────────────────────────────────────────────────────────

# Rebuild eval datasets from the official index + hand-written sets (deterministic)
eval-build:
    uv run python -m eval.build_datasets

# Tune search.hybrid_text_weight on the DEV split only (never the test sets)
# -> ../docs/report/data/fusion_tuning.json; copy the chosen value into configs/config.yaml
eval-tune:
    uv run python -m eval.tune_fusion

# Run the search evaluation (LM Studio up) -> ../docs/report/search-eval-results.md
# Pass a number for a quick smoke test: just eval-search 5
eval-search LIMIT="":
    uv run python -m eval.run_search_eval {{ if LIMIT != "" { "--limit-per-set " + LIMIT } else { "" } }}

# Live Jev check through AI Gateway (synthetic note only; costs < $0.001):
# account access, per-option probabilities, 100-candidate limit, latency, cost, ZDR
jev-check:
    uv run python -m eval.jev_check

# ── Migrations ────────────────────────────────────────────────────────────────

# Apply all pending migrations
migrate:
    uv run alembic upgrade head

# Roll back the most recent migration
migrate-down:
    uv run alembic downgrade -1

# Show current migration state
migrate-status:
    uv run alembic current

# Show migration history
migrate-history:
    uv run alembic history --verbose

# Generate a new autogenerated migration (requires DB to be running)
# Usage: just migrate-generate "add_concept_embedding"
migrate-generate NAME:
    uv run alembic revision --autogenerate -m "{{NAME}}"

# ── Frontend contract ─────────────────────────────────────────────────────────

# Export the OpenAPI spec for the frontend's generated types
# (then in ../frontend: pnpm gen:api)
openapi:
    uv run python -c "import json, os; os.environ.setdefault('DATABASE_URL', 'postgresql+asyncpg://x:y@localhost/z'); from app.main import app; open('../frontend/openapi.json', 'w', encoding='utf-8').write(json.dumps(app.openapi(), indent=1))"
