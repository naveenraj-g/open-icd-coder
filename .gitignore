# ── Secrets ───────────────────────────────────────────────────────────────────
# API keys (Jev / AI Gateway / OpenCode) and DB credentials live here.
# Only the *.example templates are committed.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ── ICD-10-CM source files ────────────────────────────────────────────────────
# Download from CDC/NCHS (see data/README.md) — not redistributed here.
data/*
!data/README.md

# ── Python (backend) ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Node / Next.js (frontend) ─────────────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel

# ── Evaluation outputs ────────────────────────────────────────────────────────
# Live working copy rewritten by every `just eval-search` run. The frozen
# per-report copies (search_eval_results_reportNN.json) ARE committed — the
# reports link to them.
docs/report/data/search_eval_results.json

# ── Editors / OS / tools ──────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
*.log
graphify-out/
