# Normalise text files to LF in the repository; checkouts follow the platform.
* text=auto

# Shell-style files must stay LF everywhere (just / docker / sh)
justfile text eol=lf
*.sh text eol=lf
*.sql text eol=lf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
*.gguf binary
